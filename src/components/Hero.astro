---
interface Props {
  memorialBtnText?: string;
  memorialBtnUrl?: string;
  scrollBtnText?: string;
}

const {
  memorialBtnText = "View Memorial",
  memorialBtnUrl = "/projects/bethel",
  scrollBtnText = "Explore",
} = Astro.props;
---

<section class="hero" id="hero">
  <video class="hero-video" id="heroVideo" autoplay loop muted playsinline preload="auto">
    <source src="/les-oiseaux-web.webm" type="video/webm">
    <source src="/les-oiseaux-web.mp4" type="video/mp4">
    Your browser does not support video playback.
  </video>

  <!-- Transparent Overlay to keep video text 100% visible -->
  <div class="hero-overlay" style="background: rgba(10, 10, 12, 0.2);"></div>

  <div class="hero-bottom-actions">
    <!-- Floating Link for Bethel Burying Ground -->
    <a href={memorialBtnUrl} class="hero-memorial-btn" title="Discover the Bethel Burying Ground project">
      <span>{memorialBtnText}</span>
      <span class="memorial-arrow">→</span>
    </a>

    <a href="#about" class="scroll-indicator" aria-label="Scroll down">
      <div class="scroll-mouse">
        <div class="scroll-wheel"></div>
      </div>
      <span>{scrollBtnText}</span>
    </a>
  </div>
</section>
