---
interface Props {
  title?: string;
  subtitle?: string;
  description?: string;
  timelineBtnText?: string;
}

const {
  title = "Artistic Journey of Muhsana Ali",
  subtitle = "Geography & International Journey",
  description = "Explore cities, residencies, exhibitions, and community projects across Africa, Europe, and the United States.",
  timelineBtnText = "Timeline",
} = Astro.props;
---

<section class="section" id="interactive-map">
  <div class="section-header">
    <p class="section-subtitle">{subtitle}</p>
    <h2 class="section-title">{title}</h2>
    <p class="map-section-desc">{description}</p>
    <div class="section-divider"></div>
  </div>

  <!-- Map Filter Buttons -->
  <div class="map-filters" id="mapFilters">
    <button class="filter-btn active" data-filter="all">All</button>
    <button class="filter-btn" data-filter="education">Education</button>
    <button class="filter-btn" data-filter="exhibition">Exhibitions</button>
    <button class="filter-btn" data-filter="residency">Residencies</button>
    <button class="filter-btn" data-filter="project">Projects</button>
    <button class="filter-btn" data-filter="conference">Conferences</button>
    <button class="filter-btn timeline-btn" id="btnPlayTimeline"><span class="timeline-icon">▶</span> {timelineBtnText}</button>
  </div>

  <!-- Map Container & Details Panel Layout -->
  <div class="map-layout">
    <div class="map-container-wrapper">
      <div id="map"></div>
    </div>

    <!-- Info Details Drawer / Panel -->
    <aside class="map-info-panel" id="mapInfoPanel">
      <div class="info-panel-header">
        <h3 id="panelLocationTitle">Select a location</h3>
        <p id="panelLocationSubtitle" class="panel-subtitle">Click on a map marker to display journey details.</p>
      </div>
      <div class="info-panel-content" id="panelLocationEvents">
        <div class="info-empty-state">
          <span class="empty-icon">📍</span>
          <p>Discover events, exhibitions, and community projects organized in each city.</p>
        </div>
      </div>
    </aside>
  </div>
</section>
