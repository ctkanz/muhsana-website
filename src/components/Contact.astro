---
interface Props {
  title?: string;
  subtitle?: string;
  lang?: 'en' | 'fr' | 'es' | string;
}

const {
  title,
  subtitle,
  lang = "en",
} = Astro.props;

const isFr = lang === 'fr';
const isEs = lang === 'es';
const isZhTw = lang === 'zh-tw';
const isZhCn = lang === 'zh-cn';
const isAr = lang === 'ar';

const defaultTitle = isFr ? "Contactez-moi" : (isEs ? "Contacto" : (isZhTw ? "聯繫我" : (isZhCn ? "联系我" : (isAr ? "تواصل معي" : "Contact Me"))));
const defaultSubtitle = isFr ? "Restons en contact" : (isEs ? "Sigamos en contacto" : (isZhTw ? "保持聯繫" : (isZhCn ? "保持联系" : (isAr ? "ابق على تواصل" : "Get In Touch"))));

const sectionTitle = title || defaultTitle;
const sectionSubtitle = subtitle || defaultSubtitle;

const formLabels = {
  name: isFr ? "Nom" : (isEs ? "Nombre" : (isZhTw ? "姓名" : (isZhCn ? "姓名" : (isAr ? "الاسم" : "Name")))),
  email: isFr ? "E-mail" : (isEs ? "Correo electrónico" : (isZhTw ? "電子郵件" : (isZhCn ? "电子邮件" : (isAr ? "البريد الإلكتروني" : "Email")))),
  subject: isFr ? "Sujet" : (isEs ? "Asunto" : (isZhTw ? "主題" : (isZhCn ? "主题" : (isAr ? "الموضوع" : "Subject")))),
  message: isFr ? "Votre message..." : (isEs ? "Escriba su mensaje aquí..." : (isZhTw ? "請在此輸入您的訊息..." : (isZhCn ? "请在此输入您的消息..." : (isAr ? "اكتب رسالتك هنا..." : "Type your message here...")))),
  submit: isFr ? "Envoyer le message" : (isEs ? "Enviar mensaje" : (isZhTw ? "發送訊息" : (isZhCn ? "发送消息" : (isAr ? "إرسال الرسالة" : "Submit Message")))),
  phone: isFr ? "Téléphone & WhatsApp" : (isEs ? "Teléfono y WhatsApp" : (isZhTw ? "電話與 WhatsApp" : (isZhCn ? "电话与 WhatsApp" : (isAr ? "الهاتف و WhatsApp" : "Phone & WhatsApp")))),
  emailCard: isFr ? "E-mail" : (isEs ? "Correo electrónico" : (isZhTw ? "電子郵件" : (isZhCn ? "电子邮件" : (isAr ? "البريد الإلكتروني" : "Email")))),
  connect: isFr ? "Réseaux sociaux" : (isEs ? "Redes Sociales" : (isZhTw ? "社群連結" : (isZhCn ? "社群链接" : (isAr ? "التواصل الاجتماعي" : "Connect")))),
};

const feedbackMsgs = {
  sending: isFr ? "Envoi en cours..." : (isEs ? "Enviando..." : (isZhTw ? "傳送中..." : (isZhCn ? "发送中..." : (isAr ? "جاري الإرسال..." : "Sending...")))),
  success: isFr ? "Merci ! Votre message a bien été envoyé." : (isEs ? "¡Gracias! Su mensaje ha sido enviado." : (isZhTw ? "謝謝！您的訊息已成功傳送。" : (isZhCn ? "谢谢！您的消息已成功发送。" : (isAr ? "شكراً لك! تم إرسال رسالتك بنجاح." : "Thank you! Your message has been sent.")))),
  error: isFr ? "Une erreur s'est produite. Veuillez réessayer." : (isEs ? "Ocurrió un error. Por favor inténtelo de nuevo." : (isZhTw ? "發生錯誤，請重試。" : (isZhCn ? "发生错误，请重试。" : (isAr ? "حدث خطأ. يرجى المحاولة مرة أخرى." : "An error occurred. Please try again.")))),
};
---

<section class="section contact-section" id="contact">
  <div class="section-header">
    <p class="section-subtitle">{sectionSubtitle}</p>
    <h2 class="section-title">{sectionTitle}</h2>
    <div class="section-divider"></div>
  </div>

  <!-- Contact Info Grid (Inspired by muhsana.com) -->
  <div class="contact-info-grid">
    <div class="contact-info-card">
      <div class="info-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
      </div>
      <h3>{formLabels.phone}</h3>
      <a href="https://wa.me/221779787934" target="_blank" rel="noopener noreferrer" class="info-value">+221 77 978 79 34</a>
    </div>

    <div class="contact-info-card">
      <div class="info-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
      </div>
      <h3>{formLabels.emailCard}</h3>
      <a href="mailto:muhsaali@protonmail.com" class="info-value">muhsaali@protonmail.com</a>
    </div>

    <div class="contact-info-card">
      <div class="info-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"></path>
        </svg>
      </div>
      <h3>{formLabels.connect}</h3>
      <div class="social-links">
        <a href="https://www.linkedin.com/in/muhsana-ali-b6873539" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="social-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
          </svg>
        </a>
        <a href="https://www.youtube.com/@portesetpassagesduretour" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="social-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Contact Form Container -->
  <div class="contact-form-container">
    <form class="contact-form" id="web3ContactForm">
      <!-- Web3Forms Access Key (ou clé générée) -->
      <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY_HERE" id="web3AccessKey" />
      <input type="hidden" name="to_email" value="muhsaali@protonmail.com" />
      <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

      <div class="form-group">
        <input type="text" id="contact-name" name="name" placeholder={formLabels.name} required class="form-input" />
      </div>
      <div class="form-group">
        <input type="email" id="contact-email" name="email" placeholder={formLabels.email} required class="form-input" />
      </div>
      <div class="form-group">
        <input type="text" id="contact-subject" name="subject" placeholder={formLabels.subject} required class="form-input" />
      </div>
      <div class="form-group">
        <textarea id="contact-message" name="message" rows="5" placeholder={formLabels.message} required class="form-input form-textarea"></textarea>
      </div>
      
      <div class="form-submit-wrapper">
        <button type="submit" id="contactSubmitBtn" class="btn-primary form-submit-btn">
          <span id="btnSubmitText">{formLabels.submit}</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="22" y1="2" x2="11" y2="13"></line>
            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
          </svg>
        </button>
      </div>

      <div id="contactFormStatus" style="display: none; margin-top: 1rem; text-align: center; padding: 0.8rem; border-radius: var(--radius-sm); font-size: 0.9rem;"></div>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('web3ContactForm') as HTMLFormElement | null;
  const statusDiv = document.getElementById('contactFormStatus');
  const btnText = document.getElementById('btnSubmitText');
  const submitBtn = document.getElementById('contactSubmitBtn') as HTMLButtonElement | null;

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      if (btnText) btnText.textContent = "Envoi en cours...";
      if (submitBtn) submitBtn.disabled = true;
      if (statusDiv) {
        statusDiv.style.display = 'block';
        statusDiv.style.background = 'rgba(212, 175, 55, 0.1)';
        statusDiv.style.color = 'var(--accent-gold)';
        statusDiv.textContent = "Envoi en cours...";
      }

      const formData = new FormData(form);
      const accessKey = (document.getElementById('web3AccessKey') as HTMLInputElement)?.value;

      // S'il s'agit du placeholder, basculer sur Web3Forms API ou Mailto direct
      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: formData
        });

        const data = await response.json();

        if (data.success) {
          if (statusDiv) {
            statusDiv.style.background = 'rgba(40, 167, 69, 0.15)';
            statusDiv.style.color = '#28a745';
            statusDiv.textContent = "Merci ! Votre message a bien été envoyé.";
          }
          form.reset();
        } else {
          // Si la clé n'est pas encore activée, ouvrir le client mail propre avec les données
          triggerMailFallback(formData);
        }
      } catch (err) {
        triggerMailFallback(formData);
      } finally {
        if (btnText) btnText.textContent = "Envoyer le message";
        if (submitBtn) submitBtn.disabled = false;
      }
    });

    function triggerMailFallback(formData: FormData) {
      const name = formData.get('name') || '';
      const email = formData.get('email') || '';
      const subject = formData.get('subject') || '';
      const message = formData.get('message') || '';

      const mailtoUrl = `mailto:muhsaali@protonmail.com?subject=${encodeURIComponent(subject.toString())}&body=${encodeURIComponent(`De: ${name} (${email})\n\n${message}`)}`;
      window.location.href = mailtoUrl;

      if (statusDiv) {
        statusDiv.style.background = 'rgba(212, 175, 55, 0.15)';
        statusDiv.style.color = 'var(--accent-gold)';
        statusDiv.textContent = "Ouverture de votre messagerie...";
      }
    }
  }
</script>
