---
import { getCollection, getEntry } from 'astro:content';

interface Props {
  isProjectPage?: boolean;
  lang?: string;
  currentPath?: string;
}

const { isProjectPage = false, lang = 'en', currentPath = '' } = Astro.props;

const isFr = lang === 'fr';
const homeSlug = isFr ? 'fr/home' : 'en/home';
const pagePrefix = isProjectPage ? (isFr ? '/fr' : '/') : '';

// Calculate dynamic language switcher targets
let enTarget = '/';
let frTarget = '/fr';

if (currentPath) {
  if (currentPath.startsWith('/fr/')) {
    enTarget = currentPath.replace(/^\/fr/, '') || '/';
    frTarget = currentPath;
  } else if (currentPath === '/fr') {
    enTarget = '/';
    frTarget = '/fr';
  } else {
    enTarget = currentPath;
    frTarget = `/fr${currentPath === '/' ? '' : currentPath}`;
  }
}

// 1. Fetch home page data for blocks and artwork filters
const homeEntry = await getEntry('pages', homeSlug as any);
const homeData = homeEntry?.data || {};
const blocks = homeData.blocks || [];

// Artwork Filters
const rawArtworkFilters = homeData.artworkFilters || [];
const artworkCategories = rawArtworkFilters.filter((f: any) => f.value && f.value !== 'all');

// 2. Fetch all projects from content collection filtered by lang
const rawProjects = await getCollection('projects');
const langProjects = rawProjects.filter(p => p.slug.startsWith(`${lang}/`));
const sortedProjects = langProjects.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
---

<nav class={`navbar ${isProjectPage ? 'scrolled' : ''}`}>
  <a href={`${pagePrefix}#hero`} class="brand-logo">Muhsana <span>Ali</span></a>

  <ul class="nav-menu" id="navMenu">
    <button class="mobile-close-btn" id="mobileCloseBtn" aria-label="Close menu">✕</button>
    <li class="nav-item"><a href={`${pagePrefix}#hero`} class="nav-link active">{isFr ? 'Accueil' : 'Home'}</a></li>

    {blocks.map((block: any) => {
      if (block.active === false) return null;
      const type = block.type;

      if (type === 'about_block') {
        return (
          <li class="nav-item">
            <a href={`${pagePrefix}#about`} class="nav-link">{block.navTitle || block.title || (isFr ? 'À Propos' : 'About')}</a>
          </li>
        );
      }

      if (type === 'projects_block') {
        const filter = block.sectionFilter || 'principaux';
        const sectionProjects = sortedProjects.filter(p => {
          if (!filter || filter === 'all') return true;
          return (p.data.section || 'principaux').toLowerCase().trim() === filter.toLowerCase().trim();
        });

        return (
          <li class="nav-item">
            <a href={`${pagePrefix}#projects-${filter}`} class="nav-link">{block.navTitle || (isFr ? 'Projets' : 'Projects')} ▾</a>
            <ul class="dropdown-menu">
              {(sectionProjects.length > 0 ? sectionProjects : sortedProjects).map((project) => (
                <li>
                  <a href={`${isFr ? '/fr' : ''}/projects/${project.slug.replace(new RegExp(`^${lang}/`), '')}`} class="dropdown-link">
                    {project.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        );
      }

      if (type === 'artworks_block') {
        return (
          <li class="nav-item">
            <a href={`${pagePrefix}#artwork`} class="nav-link">{block.navTitle || block.title || (isFr ? 'Œuvres' : 'Artworks')} ▾</a>
            <ul class="dropdown-menu">
              {artworkCategories.map((cat: any) => (
                <li>
                  <a href={`${pagePrefix}#artwork`} class="dropdown-link" data-art-nav={cat.value}>
                    {cat.label}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        );
      }

      if (type === 'map_block') {
        return (
          <li class="nav-item">
            <a href={`${pagePrefix}#interactive-map`} class="nav-link">{block.navTitle || block.title || (isFr ? 'Parcours (Carte)' : 'Journey (Map)')}</a>
          </li>
        );
      }

      return null;
    })}

    <!-- Language Selector Dropdown -->
    <li class="nav-item lang-dropdown-item">
      <a href="#" class="nav-link lang-dropdown-btn">🌐 {lang.toUpperCase()} ▾</a>
      <ul class="dropdown-menu lang-dropdown-menu">
        <li><a href={enTarget} class={`dropdown-link ${!isFr ? 'active-lang' : ''}`}>🇬🇧 English (EN)</a></li>
        <li><a href={frTarget} class={`dropdown-link ${isFr ? 'active-lang' : ''}`}>🇫🇷 Français (FR)</a></li>
      </ul>
    </li>
  </ul>

  <div style="display: flex; align-items: center; gap: 1rem;">
    {isProjectPage ? (
      <a href={isFr ? "/fr/#projects" : "/#projects"} class="project-back-btn">
        {isFr ? '← Retour aux projets' : '← Back to projects'}
      </a>
    ) : (
      <button class="sound-btn" id="soundBtn" title={isFr ? "Activer / Désactiver le son" : "Unmute / Mute video audio"}>
        <span id="soundIcon">🔇</span>
        <span id="soundText">{isFr ? 'Activer le son' : 'Enable Sound'}</span>
      </button>
    )}
    <button class="mobile-toggle" id="mobileToggle" aria-label="Mobile Menu">☰</button>
  </div>
</nav>
