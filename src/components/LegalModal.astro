const t = translations[lang] || translations.en;
const isRtl = lang === 'ar';
---

<div id="legal-modal" class="legal-modal-overlay" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="legal-modal-dialog" dir={isRtl ? 'rtl' : 'ltr'}>
    <div class="legal-modal-header">
      <h3 class="legal-modal-title">{t.title}</h3>
      <button type="button" class="legal-modal-close" id="legal-modal-close-btn" aria-label={t.closeBtn}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="legal-modal-body">
      <section class="legal-section">
        <h4>{t.sec1Title}</h4>
        <p><strong>{t.sec1Publisher}</strong> Muhsana Ali</p>
        <p><strong>{t.sec1Contact}</strong> <a href="mailto:muhsaali@protonmail.com">muhsaali@protonmail.com</a> | +221 77 978 79 34</p>
        <p><strong>{t.sec1Address}</strong> Mbodiène, Sénégal</p>
      </section>

      <section class="legal-section">
        <h4>{t.sec2Title}</h4>
        <p><strong>{t.sec2Host}</strong> Netlify, Inc.</p>
        <p><strong>{t.sec2Address}</strong> 512 2nd Street, Suite 200, San Francisco, CA 94107, USA</p>
      </section>

      <section class="legal-section">
        <h4>{t.sec3Title}</h4>
        <p><strong>{t.sec3Copyright.split(':')[0]}:</strong> {t.sec3Copyright.substring(t.sec3Copyright.indexOf(':') + 1)}</p>
        <p><strong>{t.sec3Liability.split(':')[0]}:</strong> {t.sec3Liability.substring(t.sec3Liability.indexOf(':') + 1)}</p>
      </section>

      <section class="legal-section">
        <h4>{t.sec4Title}</h4>
        <p>{t.sec4Data}</p>
        <p class="legal-note">{t.sec4Cookies}</p>
      </section>
    </div>

    <div class="legal-modal-footer">
      <button type="button" class="legal-modal-ok-btn" id="legal-modal-ok-btn">{t.closeBtn}</button>
    </div>
  </div>
</div>

<style>
  .legal-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 100000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background: rgba(8, 8, 10, 0.85);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.3s ease;
  }

  .legal-modal-overlay.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .legal-modal-dialog {
    position: relative;
    width: 100%;
    max-width: 680px;
    max-height: 85vh;
    display: flex;
    flex-direction: column;
    background: #121217;
    border: 1px solid rgba(212, 175, 55, 0.28);
    border-radius: 16px;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.8), 0 0 40px rgba(212, 175, 55, 0.08);
    transform: scale(0.95) translateY(10px);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .legal-modal-overlay.is-active .legal-modal-dialog {
    transform: scale(1) translateY(0);
  }

  .legal-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 2rem 1.2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .legal-modal-title {
    font-family: 'Cinzel', serif;
    font-size: 1.25rem;
    color: #f3f3f5;
    font-weight: 700;
    letter-spacing: 0.04em;
    margin: 0;
  }

  .legal-modal-close {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.04);
    color: #a0a0ab;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .legal-modal-close:hover {
    color: #fff;
    background: rgba(212, 175, 55, 0.2);
    border-color: rgba(212, 175, 55, 0.4);
    transform: rotate(90deg);
  }

  .legal-modal-body {
    padding: 1.8rem 2rem;
    overflow-y: auto;
    color: #a0a0ab;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .legal-section {
    margin-bottom: 1.6rem;
  }

  .legal-section:last-child {
    margin-bottom: 0;
  }

  .legal-section h4 {
    font-family: 'Cinzel', serif;
    color: #d4af37;
    font-size: 1rem;
    margin-bottom: 0.6rem;
    font-weight: 600;
  }

  .legal-section p {
    margin-bottom: 0.5rem;
  }

  .legal-section strong {
    color: #e5e5ea;
  }

  .legal-section a {
    color: #d4af37;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .legal-section a:hover {
    color: #fff;
  }

  .legal-note {
    font-style: italic;
    color: #8c8c96;
    margin-top: 0.6rem;
  }

  .legal-modal-footer {
    padding: 1rem 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    justify-content: flex-end;
  }

  .legal-modal-ok-btn {
    padding: 0.6rem 1.6rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #f3f3f5;
    border-radius: 8px;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .legal-modal-ok-btn:hover {
    background: rgba(212, 175, 55, 0.18);
    border-color: rgba(212, 175, 55, 0.4);
    color: #d4af37;
  }

  @media (max-width: 600px) {
    .legal-modal-dialog {
      max-height: 90vh;
    }
    .legal-modal-header {
      padding: 1.2rem 1.2rem 1rem;
    }
    .legal-modal-title {
      font-size: 1.1rem;
    }
    .legal-modal-body {
      padding: 1.2rem;
      font-size: 0.88rem;
    }
    .legal-modal-footer {
      padding: 0.8rem 1.2rem;
    }
  }
</style>

<script is:inline>
  (function initLegalModal() {
    var modal = document.getElementById('legal-modal');
    var closeBtn = document.getElementById('legal-modal-close-btn');
    var okBtn = document.getElementById('legal-modal-ok-btn');

    if (!modal) return;

    function openModal(e) {
      if (e) e.preventDefault();
      modal.classList.add('is-active');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.classList.remove('is-active');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    document.addEventListener('click', function(e) {
      var trigger = e.target.closest('[data-open-legal]');
      if (trigger) {
        openModal(e);
      }
    });

    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (okBtn) okBtn.addEventListener('click', closeModal);

    modal.addEventListener('click', function(e) {
      if (e.target === modal) closeModal();
    });

    window.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && modal.classList.contains('is-active')) {
        closeModal();
      }
    });
  })();
</script>
