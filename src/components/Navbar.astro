---
import { getCollection, getEntry } from 'astro:content';

interface Props {
  isProjectPage?: boolean;
}

const { isProjectPage = false } = Astro.props;

const pagePrefix = isProjectPage ? '/' : '';

// 1. Fetch home page data for blocks and artwork filters
const homeEntry = await getEntry('pages', 'home');
const homeData = homeEntry?.data || {};
const blocks = homeData.blocks || [];

// Artwork Filters (from home.json top-level artworkFilters)
const rawArtworkFilters = homeData.artworkFilters || [
  { label: "Sculpture & Installation", value: "sculpture" },
  { label: "Alternative Mosaic", value: "mosaic" },
  { label: "Photography", value: "photography" },
  { label: "Peinture", value: "peinture" },
];
const artworkCategories = rawArtworkFilters.filter((f: any) => f.value && f.value !== 'all');

// 2. Fetch all projects from content collection
const rawProjects = await getCollection('projects');
const sortedProjects = rawProjects.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
---

<nav class={`navbar ${isProjectPage ? 'scrolled' : ''}`}>
  <a href={`${pagePrefix}#hero`} class="brand-logo">Muhsana <span>Ali</span></a>

  <ul class="nav-menu" id="navMenu">
    <button class="mobile-close-btn" id="mobileCloseBtn" aria-label="Close menu">✕</button>
    <li class="nav-item"><a href={`${pagePrefix}#hero`} class="nav-link active">Home</a></li>

    {blocks.map((block: any) => {
      if (block.active === false) return null;
      const type = block.type;

      if (type === 'about_block') {
        return (
          <li class="nav-item">
            <a href={`${pagePrefix}#about`} class="nav-link">{block.navTitle || block.title || 'About'}</a>
          </li>
        );
      }

      if (type === 'projects_block') {
        const filter = block.sectionFilter || 'principaux';
        const sectionProjects = sortedProjects.filter(p => {
          if (!filter || filter === 'all') return true;
          return (p.data.section || 'principaux').toLowerCase().trim() === filter.toLowerCase().trim();
        });

        return (
          <li class="nav-item">
            <a href={`${pagePrefix}#projects-${filter}`} class="nav-link">{block.navTitle || 'Projects'} ▾</a>
            <ul class="dropdown-menu">
              {(sectionProjects.length > 0 ? sectionProjects : sortedProjects).map((project) => (
                <li>
                  <a href={`/projects/${project.slug}`} class="dropdown-link">
                    {project.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        );
      }

      if (type === 'artworks_block') {
        return (
          <li class="nav-item">
            <a href={`${pagePrefix}#artwork`} class="nav-link">{block.navTitle || block.title || 'Artworks'} ▾</a>
            <ul class="dropdown-menu">
              {artworkCategories.map((cat: any) => (
                <li>
                  <a href={`${pagePrefix}#artwork`} class="dropdown-link" data-art-nav={cat.value}>
                    {cat.label}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        );
      }

      if (type === 'map_block') {
        return (
          <li class="nav-item">
            <a href={`${pagePrefix}#interactive-map`} class="nav-link">{block.navTitle || block.title || 'Journey (Map)'}</a>
          </li>
        );
      }

      return null;
    })}
  </ul>

  <div style="display: flex; align-items: center; gap: 1rem;">
    {isProjectPage ? (
      <a href="/#projects" class="project-back-btn">← Back to projects</a>
    ) : (
      <button class="sound-btn" id="soundBtn" title="Unmute / Mute video audio">
        <span id="soundIcon">🔇</span>
        <span id="soundText">Enable Sound</span>
      </button>
    )}
    <button class="mobile-toggle" id="mobileToggle" aria-label="Mobile Menu">☰</button>
  </div>
</nav>
